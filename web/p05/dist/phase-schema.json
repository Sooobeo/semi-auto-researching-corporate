{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source_runs",
    "summary",
    "facts",
    "review",
    "changes",
    "calculations",
    "sharing"
  ],
  "properties": {
    "schema_version": {
      "const": "p06-p07-site-0.1"
    },
    "facts": {
      "type": "array",
      "minItems": 1
    },
    "review": {
      "type": "array",
      "minItems": 1
    },
    "changes": {
      "type": "array"
    },
    "calculations": {
      "type": "array"
    },
    "sharing": {
      "type": "object",
      "properties": {
        "source_prose_included": {
          "const": false
        },
        "private_paths_included": {
          "const": false
        }
      }
    }
  }
}
