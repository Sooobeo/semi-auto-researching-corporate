{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "card_id",
    "card_version",
    "run_id",
    "candidate_refs",
    "facts",
    "changes",
    "calculations",
    "review_readiness",
    "evidence_status",
    "pipeline_status",
    "materiality_assessment"
  ],
  "properties": {
    "card_id": {
      "type": "string"
    },
    "card_version": {
      "type": "string"
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "minItems": 1
    },
    "review_readiness": {
      "const": "needs_review"
    },
    "evidence_status": {
      "const": "company_reported"
    },
    "pipeline_status": {
      "enum": [
        "succeeded",
        "partial_failure"
      ]
    },
    "materiality_assessment": {
      "type": "object",
      "properties": {
        "score": {
          "type": "null"
        }
      }
    }
  }
}
